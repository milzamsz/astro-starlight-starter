{
  "name": "astro-starlight-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Docs site starter: Astro + Starlight with tabs, grouped sidebar, search, feedback widget and a Cloudflare Pages Function",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run type-check && pnpm run validate:docs && pnpm run validate:secrets",
    "lint:js": "oxlint && eslint \"src/**/*.astro\"",
    "lint:css": "stylelint src/styles/",
    "type-check": "pnpm run type-check:astro && pnpm run type-check:functions",
    "type-check:astro": "astro check",
    "type-check:functions": "pnpm run cf:types >/dev/null && tsc --noEmit -p functions/tsconfig.json",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:secrets": "node scripts/validate-secrets.cjs",
    "format": "prettier --write 'src/**/*.{astro,ts,css}'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,css}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist",
    "cf:types": "wrangler types functions/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@iconify-json/lucide": "^1.2.155",
    "astro": "^7.4.12",
    "astro-icon": "^1.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.43.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-oxlint": "^1.94.0",
    "globals": "^17.14.0",
    "oxlint": "^1.94.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
