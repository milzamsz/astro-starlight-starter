# Security headers for Cloudflare Pages
# See: https://developers.cloudflare.com/pages/configuration/headers/
#
# The main Content-Security-Policy (script-src / style-src with SHA-256 hashes,
# img/font/connect sources) is generated per page by Astro (`security.csp` in
# astro.config.ts, sources in src/config/csp.config.ts) as a <meta> tag.
# This header only carries directives a <meta> tag cannot set (frame-ancestors)
# plus hardening defaults; it must not add script-src/style-src restrictions.
#
# HSTS: one year on this host only. includeSubDomains stays off until every
# subdomain (console., fgn-demo., …) is confirmed HTTPS-only.

/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Fingerprinted build assets never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted: cache a day so logo or image swaps show up.
/img/*
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate
